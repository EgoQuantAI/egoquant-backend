OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
# Advisor chat: signs the chat_context that /portfolio returns. Any long random string; if empty, a key
# derived from OPENAI_API_KEY is used. Optional: OPENAI_REASONING_EFFORT (default low).
EGOQUANT_CONTEXT_SECRET=

# Real end-of-day ETF prices for the engine (Agent C). Free key at tiingo.com; offline runs need none.
TIINGO_API_KEY=
# Optional second Tiingo key for the background price-cache builder (its own 50 requests/hour and 500
# tickers/month). Without it the builder shares TIINGO_API_KEY (the traders' key) and uses less of it.
TIINGO_WARM_API_KEY=

# Optional – only needed if Supabase features are enabled
SUPABASE_URL=
SUPABASE_KEY=
# Accounts (planned): the publishable anon key only. RLS protects the data; no service-role key is ever used.
SUPABASE_ANON_KEY=

# Browser origins allowed to call this API directly (comma separated). Default: our Vercel site only.
CORS_ORIGINS=https://fintechaton-frontend.vercel.app

# Optional – market briefing live sources (names only; never commit values)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=
# SEC asks for a descriptive User-Agent with contact details, e.g. "EgoQuant demo you@example.com"
SEC_USER_AGENT=
# Path to the Loughran-McDonald Master Dictionary CSV you downloaded (evaluation only)
LM_DICTIONARY_PATH=

# Demo-proofing (optional). When a live price feed fails (no key, key refused, rate limit, blocked region),
# the whole run first switches to the committed snapshot of REAL prices ("off" disables it), then, only if
# EGOQUANT_DATA_FALLBACK=synthetic, to SYNTHETIC prices, clearly labeled. Synthetic is off by default.
EGOQUANT_PRICE_SNAPSHOT=
EGOQUANT_DATA_FALLBACK=

# Price cache (Agent C). Default ~/.cache/egoquant. On Railway the disk is wiped on every redeploy: mount a
# volume and point this at it, then run `python -m egoquant warm-cache --wait` once so portfolio builds read
# ~20 years of prices from disk instead of spending Tiingo's 50 requests an hour.
EGOQUANT_CACHE_DIR=

# Background price-cache builder (on by default with a Tiingo key and real prices). Requests per hour on its
# key: default 45 with its own key, 30 when sharing the traders' key (then their requests count too).
EGOQUANT_WARM=
EGOQUANT_WARM_PER_HOUR=
EGOQUANT_WARM_PER_CLUSTER=10

# Market briefing on the web: EGOQUANT_BRIEFING=live|fixture|off (default live). The server has no FinBERT (torch is
# not installed), so news tone needs EGOQUANT_BRIEFING_LLM=1 (fund-aware gpt-4.1-mini labels; without it every
# headline shows "tone not yet assessed"). Pairs not labeled within the request are labeled in the background
# after the response (EGOQUANT_BRIEFING_TONE_BACKGROUND=off disables that part).
EGOQUANT_BRIEFING=
EGOQUANT_BRIEFING_LLM=1
EGOQUANT_BRIEFING_TONE_BACKGROUND=
